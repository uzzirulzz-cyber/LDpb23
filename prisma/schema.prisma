// PLAYBEAT PULSE — playbeat.digital CRM schema
// 15 functional domains, all real (no mocks). SQLite + Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ CRM CORE ============
model Rep {
  id        String   @id @default(cuid())
  name      String
  email     String
  avatar    String?
  role      String   @default("sales") // admin | manager | sales
  region    String?
  target    Float    @default(0)
  createdAt DateTime @default(now())
  leads     Lead[]
  seats     Seat[]
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  company    String?
  country    String?
  source     String
  status     String   @default("new")
  stage      String   @default("new")
  value      Float    @default(0)
  currency   String   @default("PKR")
  score      Int      @default(50)
  tags       String?
  assignedTo String?
  rep        Rep?     @relation(fields: [assignedTo], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activities Activity[]
  messages   Message[]
  deals      Deal[]
}

model Activity {
  id          String   @id @default(cuid())
  leadId      String
  type        String
  description String
  meta        String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  leadId    String
  channel   String
  direction String
  content   String
  status    String   @default("sent")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Deal {
  id        String    @id @default(cuid())
  leadId    String
  title     String
  value     Float
  currency  String    @default("PKR")
  stage     String    @default("new")
  closeDate DateTime?
  createdAt DateTime  @default(now())
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ============ CONTACTS & ACCOUNTS ============
model Account {
  id         String    @id @default(cuid())
  name       String
  website    String?
  industry   String?
  country    String?
  currency   String    @default("USD")
  size       String?
  ownerRepId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  contacts   Contact[]
  quotes     Quote[]
  invoices   Invoice[]
}

model Contact {
  id        String   @id @default(cuid())
  accountId String?
  firstName String
  lastName  String
  email     String
  phone     String?
  title     String?
  country   String?
  source    String?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// ============ QUOTES & INVOICES ============
model Quote {
  id        String    @id @default(cuid())
  number    String    @unique
  accountId String?
  contactId String?
  subject   String
  status    String    @default("draft") // draft | sent | accepted | rejected | expired
  currency  String    @default("USD")
  total     Float     @default(0)
  items     String    @default("[]") // JSON line items
  validUntil DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique
  accountId String?
  contactId String?
  orderId   String?
  subject   String
  status    String    @default("draft") // draft | sent | paid | overdue | cancelled
  currency  String    @default("USD")
  total     Float     @default(0)
  items     String    @default("[]") // JSON line items
  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// ============ WORKFLOWS & RULES ============
model Workflow {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  trigger     String   // lead_created | order_placed | contact_added | score_threshold | status_change
  actions     String    @default("[]") // JSON [{type, config}]
  enabled     Boolean   @default(true)
  runs        Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============ WATERFALL ENGINE ============
model WaterfallSource {
  id        String   @id @default(cuid())
  name      String
  type      String   // api | scrape | import | partner | enrichment
  priority  Int      @default(10)
  step      Int      @default(1)
  enabled   Boolean  @default(true)
  found     Int      @default(0)
  converted Int      @default(0)
  config    String   @default("{}") // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      EnrichmentRun[]
}

model EnrichmentRun {
  id          String    @id @default(cuid())
  sourceId    String
  status      String    @default("running") // running | completed | failed
  found       Int       @default(0)
  enriched    Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  source      WaterfallSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

// ============ 4-SEAT CAPACITY ============
model Seat {
  id          String    @id @default(cuid())
  label       String    // Seat 1..4
  repId       String?
  rep         Rep?      @relation(fields: [repId], references: [id], onDelete: SetNull)
  status      String    @default("active") // active | idle | offline
  role        String    @default("sales")
  lastActiveAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============ VOIP & OUTREACH ============
model OutreachCampaign {
  id        String   @id @default(cuid())
  name      String
  channel   String   // voip | whatsapp | meta | email | sms
  status    String   @default("draft") // draft | running | paused | completed
  audience  String   @default("0")
  sent      Int      @default(0)
  opened    Int      @default(0)
  replied   Int      @default(0)
  message   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  calls     CallLog[]
}

model CallLog {
  id           String    @id @default(cuid())
  campaignId   String?
  leadId       String?
  contactName  String
  contactPhone String
  direction    String    @default("outbound") // inbound | outbound
  durationSec  Int       @default(0)
  status       String    @default("completed") // completed | missed | voicemail | busy | failed
  notes        String    @default("")
  startedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())
  campaign     OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ============ CRAWLER LAB ============
model Crawler {
  id        String    @id @default(cuid())
  name      String
  targetUrl String
  schedule  String    @default("manual") // cron or manual
  status    String    @default("idle") // idle | running | completed | error
  found     Int       @default(0)
  lastRunAt DateTime?
  config    String    @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  results   CrawlResult[]
}

model CrawlResult {
  id        String   @id @default(cuid())
  crawlerId String
  title     String
  url       String
  price     Float?
  data      String   @default("{}") // JSON
  createdAt DateTime @default(now())
  crawler   Crawler  @relation(fields: [crawlerId], references: [id], onDelete: Cascade)
}

// ============ WEBSITE BUILDER CMS ============
model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  status    String   @default("draft") // published | draft
  content   String   @default("{}") // JSON blocks
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ HOMEPAGE BUILDER ============
model HomepageBlock {
  id        String   @id @default(cuid())
  type      String   // hero | banner | category | feature | product-grid | cta | testimonial
  title     String
  content   String   @default("{}") // JSON
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ ANALYTICS & TRAFFIC ============
model TrafficEvent {
  id          String   @id @default(cuid())
  path        String
  source      String   @default("direct") // direct | organic | referral | social | ads | email
  country     String?
  device      String   @default("desktop") // desktop | mobile | tablet
  sessionId   String?
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())
}

// ============ CUSTOMER ORDERS LOG ============
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerEmail   String
  userId          String?
  status          String   @default("completed") // completed | pending | refunded | cancelled | processing
  total           Float    @default(0)
  currency        String   @default("USD")
  paymentMethod   String   @default("card")
  items           String   @default("[]") // JSON items with licenseKeys
  licenseKeys     String   @default("[]") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ INVENTORY ============
model InventoryItem {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  productId    String?
  stock        Int      @default(0)
  reserved     Int      @default(0)
  reorderLevel Int      @default(5)
  location     String   @default("Warehouse PK")
  cost         Float    @default(0)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ CATALOG PRODUCTS ============
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sku         String   @unique
  category    String
  subcategory String?
  price       Float    @default(0)
  currency    String   @default("USD")
  digital     Boolean  @default(true)
  deliveryType String  @default("Instant Auto-Email")
  stock       Int      @default(0)
  description String   @default("")
  images      String   @default("[]") // JSON
  variants    String   @default("[]") // JSON
  active      Boolean  @default(true)
  rating      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ PIXEL ============
model PixelEvent {
  id         String   @id @default(cuid())
  eventName  String
  eventId    String?
  value      Float?
  currency   String?
  source     String   @default("client")
  createdAt  DateTime @default(now())
}
