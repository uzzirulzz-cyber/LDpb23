// Playbeat.digital CRM + Storefront — single source of truth
// 17 CRM sections + storefront + auth + custom fields + audit. Zero mock data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH (NextAuth JWT, custom User table) ============
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  image         String?
  role          String    @default("admin") // admin | manager | sales | customer
  passwordHash  String?
  provider      String?   // google | facebook | credentials
  providerId    String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customers     Customer[]
  auditLogs     AuditLog[]
}

// ============ STOREFRONT ============
model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  sku          String   @unique
  category     String
  subcategory  String?
  price        Float    @default(0)
  currency     String   @default("PKR")
  digital      Boolean  @default(true)
  deliveryType String   @default("Instant Auto-Email")
  stock        Int      @default(0)
  description  String   @default("")
  images       String   @default("[]")
  variants     String   @default("[]")
  active       Boolean  @default(true)
  rating       Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cartItems    CartItem[]
  orderItems   OrderItem[]
  inventory    InventoryItem?
}

model InventoryItem {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  productId    String?  @unique
  stock        Int      @default(0)
  reserved     Int      @default(0)
  reorderLevel Int      @default(5)
  location     String   @default("Warehouse PK")
  cost         Float    @default(0)
  currency     String   @default("PKR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?
  email     String   @unique
  name      String
  phone     String?
  country   String?
  city      String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders    Order[]
}

model Cart {
  id         String     @id @default(cuid())
  sessionKey String     @unique // guest session identifier (not a Customer FK)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  status          String      @default("pending") // pending | paid | fulfilled | cancelled | refunded
  paymentStatus   String      @default("unpaid")  // unpaid | paid | failed | refunded
  paymentMethod   String?
  paymentId       String?
  subtotal        Float       @default(0)
  tax             Float       @default(0)
  total           Float       @default(0)
  currency        String      @default("PKR")
  sourceCurrency  String      @default("PKR")
  fxRate          Float       @default(1)
  fxTimestamp     DateTime?
  fxSource        String?
  attribution     String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  name        String
  price       Float
  quantity    Int
  licenseKeys String  @default("[]")
  deliveryType String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

// ============ CRM: LEADS ============
model Rep {
  id        String   @id @default(cuid())
  name      String
  email     String
  avatar    String?
  role      String   @default("sales")
  region    String?
  target    Float    @default(0)
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Lead {
  id                 String    @id @default(cuid())
  name               String
  company            String?
  website            String?
  email              String?
  phone              String?
  whatsapp           String?
  country            String?
  city               String?
  industry           String?
  jobTitle           String?
  source             String    @default("manual")
  sourceProvider     String?
  externalId         String?
  ingestionTimestamp DateTime?
  rawReference       String?
  status             String    @default("new")
  stage              String    @default("new")
  verificationStatus String    @default("unverified") // unverified | pending | verified | failed
  enrichedAt         DateTime?
  consentState       String    @default("unknown") // unknown | opted_in | opted_out
  value              Float     @default(0)
  currency           String    @default("PKR")
  score              Int       @default(0)
  tags               String    @default("[]")
  customFields       String    @default("{}")
  auditTrail         String    @default("[]")
  assignedTo         String?
  rep                Rep?      @relation(fields: [assignedTo], references: [id])
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  activities         Activity[]
  messages           Message[]
  deals              Deal[]
  funnelRuns         FunnelRun[]
}

model Activity {
  id          String   @id @default(cuid())
  leadId      String?
  contactId   String?
  accountId   String?
  type        String
  description String
  meta        String   @default("{}")
  createdAt   DateTime @default(now())
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  leadId    String?
  channel   String
  direction String
  content   String
  status    String   @default("sent")
  createdAt DateTime @default(now())
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Deal {
  id        String    @id @default(cuid())
  leadId    String
  title     String
  value     Float
  currency  String    @default("PKR")
  stage     String    @default("new")
  closeDate DateTime?
  createdAt DateTime  @default(now())
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ============ CRM: CONTACTS + ACCOUNTS ============
model Account {
  id           String   @id @default(cuid())
  name         String
  domain       String?
  website      String?
  industry     String?
  employees    Int?
  locations    String   @default("[]")
  revenue      Float?
  revenueCurrency String?
  ownerRepId   String?
  status       String   @default("active")
  customFields String   @default("{}")
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  contacts     Contact[]
  quotes       Quote[]
  invoices     Invoice[]
  activities   Activity[]
}

model Contact {
  id               String   @id @default(cuid())
  accountId        String?
  firstName        String
  lastName         String
  email            String
  phones           String   @default("[]")
  emails           String   @default("[]")
  whatsapp         String?
  jobTitle         String?
  country          String?
  city             String?
  lifecycleStage   String   @default("lead")
  consentState     String   @default("unknown")
  commPreferences  String   @default("{}")
  source           String?
  tags             String   @default("[]")
  customFields     String   @default("{}")
  assignedTo       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  account          Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activities       Activity[]
}

// ============ QUOTES & INVOICES ============
model Quote {
  id         String    @id @default(cuid())
  number     String    @unique
  accountId  String?
  subject    String
  status     String    @default("draft")
  currency   String    @default("PKR")
  total      Float     @default(0)
  items      String    @default("[]")
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique
  accountId String?
  orderId   String?
  subject   String
  status    String    @default("draft")
  currency  String    @default("PKR")
  total     Float     @default(0)
  items     String    @default("[]")
  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// ============ FUNNEL ENGINE ============
model FunnelStage {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  order     Int
  type      String   @default("default")
  createdAt DateTime @default(now())
}

model FunnelRun {
  id           String    @id @default(cuid())
  leadId       String
  currentStage String
  stageHistory String    @default("[]")
  status       String    @default("running") // running | completed | abandoned
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ============ API FUNNEL RUN ============
model ApiProvider {
  id        String   @id @default(cuid())
  name      String
  type      String   // rest | graphql | webhook | oauth
  endpoint  String?
  status    String   @default("disconnected") // connected | disconnected | error | rate_limited
  config    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      ApiRun[]
}

model ApiRun {
  id          String    @id @default(cuid())
  providerId  String
  status      String    @default("running") // running | completed | failed | rate_limited
  ingested    Int       @default(0)
  validated   Int       @default(0)
  deduped     Int       @default(0)
  written     Int       @default(0)
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  provider    ApiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// ============ WORKFLOWS + RULES ============
model Workflow {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  trigger     String
  steps       String    @default("[]") // [{type:condition/action/wait, config}]
  enabled     Boolean   @default(false)
  runs        Int       @default(0)
  lastRunAt   DateTime?
  lastError   String?
  owner       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Rule {
  id          String    @id @default(cuid())
  name        String
  trigger     String
  conditions  String    @default("[]")
  actions     String    @default("[]")
  enabled     Boolean   @default(false)
  runs        Int       @default(0)
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============ WATERFALL ENGINE ============
model WaterfallSource {
  id        String   @id @default(cuid())
  name      String
  type      String
  priority  Int      @default(10)
  step      Int      @default(1)
  enabled   Boolean  @default(true)
  found     Int      @default(0)
  converted Int      @default(0)
  confidence Int     @default(0)
  config    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ BOTS (real worker framework) ============
model Bot {
  id            String    @id @default(cuid())
  name          String
  role          String    // ingestion | verification | enrichment | dedup | routing | workflow | support | checkout | notification
  provider      String?
  status        String    @default("idle") // online | busy | idle | error | disabled
  currentJob    String?
  queue         Int       @default(0)
  executions    Int       @default(0)
  successes    Int       @default(0)
  failures     Int       @default(0)
  latencyMs    Int       @default(0)
  lastHeartbeat DateTime?
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  executions_rel BotExecution[]
}

model BotExecution {
  id          String    @id @default(cuid())
  botId       String
  job         String
  status      String    @default("running") // running | success | failed
  durationMs  Int       @default(0)
  result      String    @default("{}")
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
}

// ============ INBOX ============
model InboxThread {
  id            String    @id @default(cuid())
  leadId        String?
  contactId     String?
  customerName  String
  channel       String    // meta | whatsapp | email | sms | web
  subject       String
  status        String    @default("open") // open | pending | closed
  lastMessageAt DateTime  @default(now())
  unread        Int       @default(0)
  createdAt     DateTime  @default(now())
  messages      InboxMessage[]
}

model InboxMessage {
  id        String   @id @default(cuid())
  threadId  String
  direction String   // inbound | outbound
  content   String
  channel   String
  createdAt DateTime @default(now())
  thread    InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

// ============ INTEGRATIONS ============
model Integration {
  id        String    @id @default(cuid())
  name      String
  type      String    // google | facebook | whatsapp | meta | stripe | sendgrid | twilio | apollo | clearbit
  status    String    @default("disconnected") // connected | disconnected | error
  config    String    @default("{}")
  lastSync  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ============ AUDIT LOG ============
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     String
  action    String
  entity    String
  entityId  String?
  meta      String   @default("{}")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// ============ CUSTOM FIELDS ============
model CustomField {
  id        String   @id @default(cuid())
  entity    String   // lead | contact | account
  name      String
  label     String
  type      String   // text | number | select | multiselect | date | boolean
  options   String   @default("[]")
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ============ ANALYTICS EVENTS (real event sourcing) ============
model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String   // page_view | order_placed | lead_created | payment_received | signup
  entity     String?
  entityId   String?
  value      Float?
  currency   String?
  source     String?
  meta       String   @default("{}")
  createdAt  DateTime @default(now())
}

// ============ CMS / HOMEPAGE (storefront) ============
model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  status    String   @default("draft")
  content   String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageBlock {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String   @default("{}")
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ PIXEL ============
model PixelEvent {
  id         String   @id @default(cuid())
  eventName  String
  eventId    String?
  value      Float?
  currency   String?
  source     String   @default("client")
  createdAt  DateTime @default(now())
}
