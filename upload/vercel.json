{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/webhook(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/.*|webhook.*).*)",
      "destination": "/index.html"
    }
  ]
}
